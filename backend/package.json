{
  "name": "backend",
  "version": "1.0.0",
  "description": "KhataSathi Backend API",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "pnpm build && node --test dist/tests/*.test.js",
    "prepare:supplier-review": "ts-node-dev --transpile-only --exit-child src/scripts/importSupplierProducts.ts",
    "pilot:audit": "ts-node-dev --transpile-only --exit-child src/scripts/auditCleanPilot.ts",
    "pilot:export-identities": "ts-node-dev --transpile-only --exit-child src/scripts/exportCleanPilotIdentities.ts",
    "pilot:import-identities": "ts-node-dev --transpile-only --exit-child src/scripts/importCleanPilotIdentities.ts",
    "fulfill:supplier-stock": "ts-node-dev --transpile-only --exit-child src/scripts/fulfillSupplierStock.ts",
    "search:seed-aliases": "ts-node-dev --transpile-only --exit-child src/scripts/seedProductSearchAliases.ts",
    "search:rebuild": "ts-node-dev --transpile-only --exit-child src/scripts/rebuildProductSearchDocuments.ts",
    "search:benchmark-typos": "ts-node-dev --transpile-only --exit-child src/scripts/benchmarkProductSearchTypoTolerance.ts",
    "auth:audit-identities": "ts-node-dev --transpile-only --exit-child src/scripts/auditUserIdentityData.ts",
    "auth:remediate-archived-phones": "ts-node-dev --transpile-only --exit-child src/scripts/remediateArchivedUserPhones.ts",
    "products:backfill-media": "node dist/scripts/backfillProductMedia.js",
    "documents:backfill-thumbnails": "ts-node-dev --transpile-only --exit-child src/scripts/backfillDocumentThumbnails.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "ts-node-dev prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.27.0",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "multer": "^2.0.2",
    "mysql2": "^3.16.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "prisma": "^5.22.0",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
