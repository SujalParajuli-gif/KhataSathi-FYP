// KhataSathi — Prisma Schema (MySQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
}

enum PaymentMethod {
  CASH
  ESEWA
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentStatusInvoice {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum StockTxType {
  SALE
  RESTOCK
  ADJUSTMENT
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  phone             String?  @unique
  gender            String?
  address           String?
  passwordHash      String
  role              Role     @default(CASHIER)
  isActive          Boolean  @default(true)
  lastLogin         DateTime?
  profileImage      String?
  nagariktaNo       String?
  createdAt         DateTime @default(now())

  invoices          Invoice[] @relation("CashierInvoices")
  cancelledInvoices Invoice[] @relation("CancelledInvoices")
  payments          Payment[]
  stockTransactions StockTransaction[]
  auditLogs         AuditLog[]
  userAlerts        UserAlertRead[]
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ip        String?
  createdAt DateTime @default(now())
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id                    String   @id @default(cuid())
  name                  String
  sku                   String   @unique
  barcode               String?  @unique
  brandId               String
  category              String?
  retailPrice           Float
  wholesalePrice        Float
  wholesaleQtyThreshold Int      @default(1)
  usesDefaultWholesaleQtyThreshold Boolean @default(false)
  stock                 Int      @default(0)
  lowStockThreshold     Int      @default(5)
  usesDefaultLowStockThreshold Boolean @default(false)
  isActive              Boolean  @default(true)
  imageUrl              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  brand             Brand              @relation(fields: [brandId], references: [id])
  invoiceItems      InvoiceItem[]
  stockTransactions StockTransaction[]

  @@index([barcode])
  @@index([sku])
}

model Customer {
  id               String   @id @default(cuid())
  name             String
  phone            String?  @unique
  email            String?
  loyaltyPercent   Float    @default(0)
  wholesalePercent Float    @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  invoices Invoice[]
}

model Invoice {
  id                     String               @id @default(cuid())
  invoiceNo              String               @unique
  status                 InvoiceStatus        @default(DRAFT)
  cashierId              String
  cancelledById          String?
  customerId             String?
  subTotal               Float                @default(0)
  loyaltyDiscountPercent Float                @default(0)
  loyaltyDiscountAmount  Float                @default(0)
  netTotal               Float                @default(0)
  paidTotal              Float                @default(0)
  paymentStatus          PaymentStatusInvoice @default(UNPAID)
  createdAt              DateTime             @default(now())
  finalizedAt            DateTime?
  cancelledAt            DateTime?

  cashier           User               @relation("CashierInvoices", fields: [cashierId], references: [id])
  cancelledBy       User?              @relation("CancelledInvoices", fields: [cancelledById], references: [id])
  customer          Customer?          @relation(fields: [customerId], references: [id])
  items             InvoiceItem[]
  payments          Payment[]
  stockTransactions StockTransaction[]
}

model BusinessSettings {
  id                           Int      @id
  defaultLowStockThreshold     Int      @default(5)
  defaultWholesaleQtyThreshold Int      @default(15)
  loyaltyDiscountPercent       Float    @default(2)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model InvoiceItem {
  id               String   @id @default(cuid())
  invoiceId        String
  productId        String
  qty              Int
  appliedUnitPrice Float
  lineTotal        Float
  createdAt        DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model UserAlertRead {
  id        String   @id @default(cuid())
  userId    String
  alertKey  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, alertKey])
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  method      PaymentMethod
  amount      Float
  status      PaymentStatus @default(PENDING)
  reference   String?
  transactionUuid String?   @unique
  createdById String
  createdAt   DateTime      @default(now())

  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])
}

model StockTransaction {
  id           String      @id @default(cuid())
  productId    String
  type         StockTxType
  qtyDelta     Int
  reason       String?
  refInvoiceId String?
  createdById  String
  createdAt    DateTime    @default(now())

  product   Product  @relation(fields: [productId], references: [id])
  invoice   Invoice? @relation(fields: [refInvoiceId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  meta       Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])
}
