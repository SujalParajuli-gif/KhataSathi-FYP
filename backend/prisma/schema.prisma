  @@index([enabled, sortOrder, id])
}

model PaymentReceivingQrAsset {
  id                         String   @id @db.VarChar(191)
  accountId                  String   @db.VarChar(191)
  publicationExpectedVersion Int
  storedPath                 String   @db.VarChar(191)
