  accountHolder       String                           @db.VarChar(120)
  accountIdentifier   String?                          @db.VarChar(120)
  settlementMethod    PaymentMethod?
  confirmationMode    PaymentReceivingConfirmationMode
  enabled             Boolean                          @default(false)
  sortOrder           Int                              @default(0)
  version             Int                              @default(1)
  creationPayloadHash String                           @db.Char(64)
  activeQrAssetId     String?                          @unique @db.VarChar(191)
  createdById         String                           @db.VarChar(191)
  updatedById         String                           @db.VarChar(191)
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  createdBy     User                     @relation("PaymentAccountCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updatedBy     User                     @relation("PaymentAccountUpdater", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  activeQrAsset PaymentReceivingQrAsset? @relation("PaymentAccountActiveQr", fields: [activeQrAssetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assets        PaymentReceivingQrAsset[] @relation("PaymentAccountAssets")
