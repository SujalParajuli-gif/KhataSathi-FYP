  sourceCorrectionId String?
  originalCustomerId String
  amount             Float
  amountReleased     Float    @default(0)
  reason             String   @db.VarChar(500)
  actorId            String
  createdAt          DateTime @default(now())
  reversedAt         DateTime?
  reversedById       String?
  reversalReason     String?  @db.VarChar(500)

