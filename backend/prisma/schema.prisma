  rows      ProductImportRow[]
  commits   ProductImportCommit[]
  repeatedFrom ProductImportBatch?  @relation("RepeatedImportBatch", fields: [repeatedFromBatchId], references: [id], onDelete: SetNull)
  repeatedBatches ProductImportBatch[] @relation("RepeatedImportBatch")

  @@index([sourceType, status, createdAt])
  @@index([createdById])
  @@index([fileFingerprint, createdAt])
  @@index([repeatedFromBatchId])
  @@index([deletedAt])
  @@index([purgeAfter])
}

model ProductImportTemplate {
