// KhataSathi — Prisma Schema (MySQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
  STAFF
}

enum ExpenseStatus {
  RECORDED
  VOIDED
}

enum ExpenseAction {
  CREATE
  CORRECT
  VOID
}

enum BusinessMode {
  CATALOG_ONLY
  INVENTORY_ONLY
  FULL_POS
}

enum SellingPriceStatus {
  PENDING
  READY
}

enum ProductAvailabilityStatus {
  CATALOG_LISTED
  COMING_SOON
}

enum TaxCalculationMode {
  UNKNOWN
  NO_VAT
  VAT_EXCLUSIVE
}

enum ProductTaxCategory {
  UNSPECIFIED
  STANDARD_VAT
  VAT_EXEMPT
}

enum ProductImportComparisonStatus {
  READY_NEW
  EXACT_DUPLICATE
  MATCHED_WITH_CHANGES
  IDENTIFIER_CONFLICT
  IN_FILE_DUPLICATE
  NEEDS_REVIEW
  FAILED
}

enum ProductImportResolution {
  CREATE_NEW
  UPDATE_MATCHED
  KEEP_EXISTING
  IGNORE
}

enum ProductImportCommitStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
}

enum PaymentMethod {
  CASH
  ESEWA
  FONEPAY
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentKind {
  CHARGE
  REFUND
}

enum PaymentStatusInvoice {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentReceivingConfirmationMode {
  MANUAL_RECEIPT
  DISPLAY_ONLY
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  CUSTOMER_REQUEST
  EXCHANGE
  OTHER
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  REVERSED
}

enum BackupJobType {
  BACKUP
  RESTORE
}

enum BackupJobStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum BackupScheduleFrequency {
  DAILY
  WEEKLY
}

enum CashDrawerStatus {
  OPEN
  CLOSED
}

enum CashDrawerEventType {
  OPEN
  CASH_IN
  CASH_OUT
  CLOSE
}

enum StockTxType {
  SALE
  RESTOCK
  ADJUSTMENT
}

enum DocumentType {
  STOCK_BILL
  PRODUCT_IMPORT
  RETURN_PROOF
  PAYMENT_PROOF
  DISCOUNT_PROOF
  GENERAL
  SALE_BILL
  PURCHASE_BILL
}

enum BillingChannel {
  MANUAL_EXTERNAL
  IRD_ELECTRONIC
}

enum ExternalDocumentType {
  PAN_INVOICE
  VAT_TAX_INVOICE
  ABBREVIATED_TAX_INVOICE
  OTHER_MANUAL_SALES_DOCUMENT
}

enum BillRecordStatus {
  PENDING
  RECORDED
  VERIFIED
  MISSING
}

enum SaleRecoveryStatus {
  UNRESOLVED
  ATTACHED
  ARCHIVED
}

enum DocumentVisibility {
  ALL_AUTHENTICATED
  ADMIN_MANAGER
  ADMIN_ONLY
}

enum CustomerDiscountRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DraftRequestStatus {
  PENDING
  ACCEPTED
  MODIFIED
  REJECTED
  COMPLETED
  EXPIRED
  CANCELLED_BY_STAFF
  CANCELLED_BY_CASHIER
  PARTIALLY_ACCEPTED
}

enum DraftRequestItemStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String?   @unique
  phone          String?   @unique
  gender         String?
  address        String?
  passwordHash   String
  mustChangePassword Boolean @default(false)
  role           Role      @default(CASHIER)
  isActive       Boolean   @default(true)
  lastLogin      DateTime?
  lastPresenceAt DateTime?
  profileImage   String?
  nagariktaNo    String?
  createdAt      DateTime  @default(now())

  invoices                    Invoice[]                    @relation("CashierInvoices")
  cancelledInvoices           Invoice[]                    @relation("CancelledInvoices")
  payments                    Payment[]                    @relation("PaymentCreator")
  voidedPayments              Payment[]                    @relation("PaymentVoider")
  stockTransactions           StockTransaction[]
  auditLogs                   AuditLog[]
  userAlerts                  UserAlertRead[]
  creditNotes                 CreditNote[]
  createdReturnRequests       ReturnRequest[]              @relation("ReturnRequestCreator")
  returnOperations            ReturnOperation[]
  creditApplications          CustomerCreditApplication[] @relation("CreditApplicationActor")
  reversedCreditApplications  CustomerCreditApplication[] @relation("CreditApplicationReverser")
  creditOperations            CustomerCreditOperation[]
  invoiceCorrections          InvoiceCorrectionSettlement[]
  reviewedReturnRequests      ReturnRequest[]              @relation("ReturnRequestReviewer")
  backupJobs                  BackupJob[]
  productImportBatches        ProductImportBatch[]
  productImportCommits        ProductImportCommit[]
  productImportTemplates      ProductImportTemplate[]
  cashDrawers                 CashDrawer[]                 @relation("CashDrawerCashier")
  cashDrawerEvents            CashDrawerEvent[]
  documents                   Document[]
  stockReceiveBatches         StockReceiveBatch[]
  softDeleteRecords           SoftDeleteRecord[]
  cashierPrivilege            CashierPrivilege?            @relation("CashierPrivilegeUser")
  updatedCashierPrivileges    CashierPrivilege[]           @relation("CashierPrivilegeUpdater")
  createdCustomers            Customer[]                   @relation("CustomerCreator")
  createdDiscountRequests     CustomerDiscountRequest[]    @relation("CustomerDiscountRequestCreator")
  reviewedDiscountRequests    CustomerDiscountRequest[]    @relation("CustomerDiscountRequestReviewer")
  priceOverrideAuthorizations PriceOverrideAuthorization[]
  overridePinAttempts         OverridePinAttempt[]
  createdDraftRequests        BillingDraftRequest[]        @relation("DraftRequestCreator")
  assignedDraftRequests       BillingDraftRequest[]        @relation("DraftRequestAssignedCashier")
  acceptedDraftRequests       BillingDraftRequest[]        @relation("DraftRequestAcceptor")
  cancelledDraftRequests      BillingDraftRequest[]        @relation("DraftRequestCanceller")
  approvedSearchSynonyms      ProductSearchSynonym[]       @relation("ProductSearchSynonymApprover")
  approvedProductAliases      ProductSearchAlias[]         @relation("ProductSearchAliasApprover")
  productSearchQueries        ProductSearchQueryLog[]
  productSearchSelections     ProductSearchSelection[]
  authSessions                AuthSession[]
  checkoutOperations          CheckoutOperation[]
  paymentAccountsCreated      PaymentReceivingAccount[]    @relation("PaymentAccountCreator")
  paymentAccountsUpdated      PaymentReceivingAccount[]    @relation("PaymentAccountUpdater")
  paymentQrAssetsCreated      PaymentReceivingQrAsset[]    @relation("PaymentQrAssetCreator")
  createdSupplierPayments     SupplierPayment[]            @relation("SupplierPaymentCreator")
  voidedSupplierPayments      SupplierPayment[]            @relation("SupplierPaymentVoider")
  expenses                    Expense[]
  expenseRevisions            ExpenseRevision[]

  @@index([role, isActive, lastPresenceAt])
  creditPayouts CustomerCreditPayout[] @relation("CreditPayoutActor")
  creditRecoveries CustomerCreditPayout[] @relation("CreditPayoutRecoverer")
  creditPayoutOperations CustomerCreditPayoutOperation[]
}

model AuthSession {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique @db.Char(64)
  csrfTokenHash String    @db.Char(64)
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ip        String?
  createdAt DateTime @default(now())
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id                               String   @id @default(cuid())
  name                             String
  productName                      String?
  catalogIdentityHash              String?  @unique @db.Char(64)
  sku                              String   @unique
  barcode                          String?  @unique
  barcodeOrigin                    String   @default("MANUFACTURER")
  brandId                          String
  category                         String?
  categoryGroup                    String?
  vendorSource                     String?
  productCodeVariant               String?
  sizeValue                        Float?
  sizeUnit                         String   @default("STANDARD")
  ratePerPiece                     Float?
  rateUpdatedAt                    DateTime?
  packageQuantity                  Float?
  packageUnit                      String   @default("PIECE")
  saleUnit                         String   @default("PIECE")
  allowFractionalQty               Boolean  @default(false)
  quantityStep                     Float    @default(1)
  wholesaleEligible                Boolean  @default(true)
  sourceCitation                   String?
  sellingPriceStatus               SellingPriceStatus @default(READY)
  availabilityStatus               ProductAvailabilityStatus @default(CATALOG_LISTED)
  taxCategory                      ProductTaxCategory         @default(UNSPECIFIED)
  retailPrice                      Float?
  wholesalePrice                   Float?
  wholesaleQtyThreshold            Float    @default(1)
  usesDefaultWholesaleQtyThreshold Boolean  @default(false)
  stock                            Float    @default(0)
  reservedStock                    Float    @default(0)
  lowStockThreshold                Float    @default(5)
  usesDefaultLowStockThreshold     Boolean  @default(false)
  isActive                         Boolean  @default(true)
  imageUrl                         String?
  thumbnailUrl                     String?
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  brand                       Brand                        @relation(fields: [brandId], references: [id])
  invoiceItems                InvoiceItem[]
  stockTransactions           StockTransaction[]
  returnItems                 ReturnItem[]
  priceOverrideAuthorizations PriceOverrideAuthorization[]
  draftRequestItems           DraftRequestItem[]
  searchAliases               ProductSearchAlias[]
  searchDocument              ProductSearchDocument?
  searchSelections            ProductSearchSelection[]
  matchedImportRows           ProductImportRow[]             @relation("MatchedImportProduct")
  purchaseBatchItems          StockReceiveBatchItem[]

  @@index([barcode])
  @@index([sku])
  @@index([categoryGroup])
  @@index([vendorSource])
  @@index([sizeUnit])
  @@index([packageUnit])
  @@index([sellingPriceStatus, isActive])
  @@index([availabilityStatus, isActive])
}

model ProductSearchSynonym {
  id                      String   @id @default(cuid())
  alias                   String
  normalizedAlias         String   @unique
  canonicalTerm           String
  normalizedCanonicalTerm String
  source                  String
  isEnabled               Boolean  @default(true)
  approvedById            String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  approvedBy User @relation("ProductSearchSynonymApprover", fields: [approvedById], references: [id])

  @@index([isEnabled, normalizedCanonicalTerm])
  @@index([approvedById])
}

model ProductSearchAlias {
  id              String   @id @default(cuid())
  productId       String
  alias           String
  normalizedAlias String
  source          String
  isEnabled       Boolean  @default(true)
  approvedById    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  approvedBy User    @relation("ProductSearchAliasApprover", fields: [approvedById], references: [id])

  @@unique([productId, normalizedAlias])
  @@index([productId, isEnabled])
  @@index([approvedById])
}

model ProductSearchDocument {
  productId         String   @id
  normalizedText    String   @db.LongText
  normalizerVersion Int
  updatedAt         DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([normalizerVersion])
}

model ProductSearchQueryLog {
  id                String   @id @default(cuid())
  rawQuery          String   @db.VarChar(160)
  normalizedQuery   String   @db.VarChar(160)
  source            String   @db.VarChar(32)
  filters           Json?
  filterFingerprint String   @db.VarChar(64)
  resultCount       Int
  durationMs        Int
  occurrenceCount   Int      @default(1)
  sessionHash       String?  @db.VarChar(64)
  actorId           String?
  lastSearchedAt    DateTime @default(now())
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  actor      User?                    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  selections ProductSearchSelection[]

  @@index([resultCount, lastSearchedAt], map: "PSQuery_result_last_idx")
  @@index([normalizedQuery, source, lastSearchedAt], map: "PSQuery_norm_source_last_idx")
  @@index([sessionHash, filterFingerprint, lastSearchedAt], map: "PSQuery_session_filter_last_idx")
  @@index([expiresAt], map: "PSQuery_expires_idx")
  @@index([actorId], map: "PSQuery_actor_idx")
}

model ProductSearchSelection {
  id          String   @id @default(cuid())
  searchLogId String
  productId   String
  actorId     String?
  action      String   @db.VarChar(32)
  createdAt   DateTime @default(now())

  searchLog ProductSearchQueryLog @relation(fields: [searchLogId], references: [id], onDelete: Cascade)
  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  actor     User?                 @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([searchLogId, productId, action], map: "PSSelection_search_product_action_key")
  @@index([productId, createdAt], map: "PSSelection_product_created_idx")
  @@index([actorId], map: "PSSelection_actor_idx")
}

model Customer {
  id               String   @id @default(cuid())
  name             String
  phone            String?  @unique
  email            String?
  loyaltyPercent   Float    @default(0)
  wholesalePercent Float    @default(0)
  isActive         Boolean  @default(true)
  createdById      String?
  createdByRole    Role?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  panNo   String?
  address String?  @db.Text

  createdBy        User?                     @relation("CustomerCreator", fields: [createdById], references: [id])
  invoices         Invoice[]
  discountRequests CustomerDiscountRequest[] @relation("CustomerDiscountRequestApprovedCustomer")
  draftRequests    BillingDraftRequest[]

  @@index([createdById])
}

model CustomerDiscountRequest {
  id                 String                        @id @default(cuid())
  customerName       String
  phone              String
  email              String?
  discountType       String
  discountPercent    Float
  reason             String?                       @db.Text
  status             CustomerDiscountRequestStatus @default(PENDING)
  requestedById      String
  reviewedById       String?
  reviewedAt         DateTime?
  adminNote          String?                       @db.Text
  approvedCustomerId String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  requestedBy      User      @relation("CustomerDiscountRequestCreator", fields: [requestedById], references: [id])
  reviewedBy       User?     @relation("CustomerDiscountRequestReviewer", fields: [reviewedById], references: [id])
  approvedCustomer Customer? @relation("CustomerDiscountRequestApprovedCustomer", fields: [approvedCustomerId], references: [id])

  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@index([phone])
  @@index([reviewedById])
  @@index([approvedCustomerId])
}

model CashierPrivilege {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  canCreateDiscountedCustomer Boolean  @default(false)
  maxCustomerLoyaltyPercent   Float    @default(5)
  maxCustomerWholesalePercent Float    @default(10)
  canRequestCustomerDiscount  Boolean  @default(true)
  canOverrideBillingPrice     Boolean  @default(false)
  canApplyManualDiscount      Boolean  @default(false)
  canVoidPayment              Boolean  @default(false)
  canViewWholesalePrice       Boolean  @default(true)
  updatedById                 String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  user      User  @relation("CashierPrivilegeUser", fields: [userId], references: [id])
  updatedBy User? @relation("CashierPrivilegeUpdater", fields: [updatedById], references: [id])

  @@index([updatedById])
}

model Invoice {
  id                     String               @id @default(cuid())
  invoiceNo              String               @unique
  status                 InvoiceStatus        @default(DRAFT)
  cashierId              String
  cancelledById          String?
  customerId             String?
  subTotal               Float                @default(0)
  loyaltyDiscountPercent Float                @default(0)
  loyaltyDiscountAmount  Float                @default(0)
  netTotal               Float                @default(0)
  paidTotal              Float                @default(0)
  returnAdjustment       Int                  @default(0)
  correctionCredit       Float                @default(0)
  correctionCreditReleased Float              @default(0)
  creditApplied          Float                @default(0)
  paymentStatus          PaymentStatusInvoice @default(UNPAID)
  notes                  String?              @db.Text
  parkedLabel                String?
  parkedAt                   DateTime?
  customerNameSnapshot       String?
  customerPanSnapshot        String?
  customerAddressSnapshot    String?              @db.Text
  customerSnapshotCapturedAt DateTime?
  billingChannel             BillingChannel?
  externalDocumentType       ExternalDocumentType?
  externalBillNo             String?              @db.VarChar(100)
  externalBillDate           DateTime?            @db.Date
  billRecordStatus           BillRecordStatus?
  createdAt                  DateTime             @default(now())
  finalizedAt            DateTime?
  cancelledAt            DateTime?
  deletedAt              DateTime?

  cashier                 User                 @relation("CashierInvoices", fields: [cashierId], references: [id])
  cancelledBy             User?                @relation("CancelledInvoices", fields: [cancelledById], references: [id])
  customer                Customer?            @relation(fields: [customerId], references: [id])
  items                   InvoiceItem[]
  payments                Payment[]
  stockTransactions       StockTransaction[]
  creditNotesAsOriginal   CreditNote[]         @relation("CreditNoteOriginalInvoice")
  creditNoteAsReplacement CreditNote?          @relation("CreditNoteReplacementInvoice")
  returnRequests          ReturnRequest[]
  creditApplicationsFrom  CustomerCreditApplication[] @relation("CreditApplicationSource")
  creditApplicationsTo    CustomerCreditApplication[] @relation("CreditApplicationTarget")
  correctionAsSource      InvoiceCorrectionSettlement? @relation("CorrectionSource")
  correctionAsTarget      InvoiceCorrectionSettlement? @relation("CorrectionTarget")
  completedDraftRequest   BillingDraftRequest?
  checkoutOperation       CheckoutOperation?

  @@index([status, parkedAt])
  @@index([status, billingChannel, billRecordStatus, cancelledAt, deletedAt, finalizedAt, id], map: "Invoice_manual_bill_queue_idx")
  @@index([externalDocumentType, externalBillNo, externalBillDate], map: "Invoice_external_reference_idx")
  creditPayouts CustomerCreditPayout[]
}

model CheckoutOperation {
  id            String   @id @default(cuid())
  operationKey  String   @unique @db.VarChar(120)
  actorId       String
  payloadHash   String   @db.Char(64)
  invoiceId     String?  @unique
  responseJson  Json?
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  actor   User     @relation(fields: [actorId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([actorId, createdAt])
}

model InvoiceSequence {
  businessDate String   @id
  lastNumber   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CreditNoteSequence {
  businessDate String   @id
  lastNumber   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DraftRequestSequence {
  businessDate String   @id
  lastNumber   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CreditNote {
  id                   String   @id @default(cuid())
  creditNoteNo         String   @unique
  originalInvoiceId    String
  replacementInvoiceId String?  @unique
  reason               String?
  originalNetTotal     Float
  originalPaidTotal    Float
  replacementNetTotal  Float?
  creditedAmount       Float
  createdById          String
  createdAt            DateTime @default(now())

  originalInvoice    Invoice  @relation("CreditNoteOriginalInvoice", fields: [originalInvoiceId], references: [id])
  replacementInvoice Invoice? @relation("CreditNoteReplacementInvoice", fields: [replacementInvoiceId], references: [id])
  createdBy          User     @relation(fields: [createdById], references: [id])

  @@index([originalInvoiceId])
  @@index([createdAt])
}

model BusinessSettings {
  id                           Int          @id
  businessMode                 BusinessMode @default(FULL_POS)
  staffDraftRequestsEnabled    Boolean      @default(true)
  defaultInitialStock          Float        @default(30)
  defaultLowStockThreshold     Float        @default(5)
  defaultWholesaleQtyThreshold Float        @default(15)
  loyaltyDiscountPercent       Float        @default(2)
  returnWindowDays             Int          @default(7)
  parkedBillExpiryHours        Int          @default(8)
  draftRequestExpiryMinutes    Int          @default(30)
  overridePinHash              String?
  overridePinUpdatedAt         DateTime?
  businessName                 String?
  legalName                    String?
  panNo                        String?
  businessAddress              String?      @db.Text
  businessPhone                String?
  taxCalculationMode           TaxCalculationMode @default(UNKNOWN)
  defaultBillingChannel        BillingChannel?
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt
}

model ProductSequence {
  id         String   @id
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model InvoiceItem {
  id                String    @id @default(cuid())
  invoiceId         String
  productId         String
  qty               Float
  appliedUnitPrice  Float
  originalUnitPrice Float?
  overrideUnitPrice Float?
  overrideReason    String?   @db.Text
  overrideById      String?
  overrideAt        DateTime?
  lineTotal           Float
  productNameSnapshot String?
  productSkuSnapshot  String?
  costAtSale          Float?
  snapshotCapturedAt  DateTime?
  createdAt           DateTime  @default(now())

  invoice     Invoice      @relation(fields: [invoiceId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])
  returnItems ReturnItem[]
}

model PriceOverrideAuthorization {
  id                String    @id @default(cuid())
  tokenHash         String    @unique
  cashierId         String
  productId         String
  customerId        String?
  qty               Float
  originalUnitPrice Float
  overrideUnitPrice Float
  overrideReason    String    @db.Text
  expiresAt         DateTime
  usedAt            DateTime?
  usedInvoiceId     String?
  createdAt         DateTime  @default(now())

  cashier User    @relation(fields: [cashierId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([cashierId, expiresAt])
  @@index([productId])
  @@index([usedAt])
}

model OverridePinAttempt {
  id            String    @id @default(cuid())
  userId        String
  action        String
  success       Boolean   @default(false)
  failureReason String?
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, success, createdAt])
  @@index([lockedUntil])
}

model ReturnRequest {
  id           String         @id @default(cuid())
  invoiceId    String
  reason       ReturnReason
  note         String?        @db.Text
  status       ReturnStatus   @default(PENDING)
  refundAmount Float          @default(0)
  settlement   Json?
  refundMethod PaymentMethod?
  createdById  String
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())

  invoice        Invoice      @relation(fields: [invoiceId], references: [id])
  createdBy      User         @relation("ReturnRequestCreator", fields: [createdById], references: [id])
  reviewedBy     User?        @relation("ReturnRequestReviewer", fields: [reviewedById], references: [id])
  items          ReturnItem[]
  refundPayments Payment[]
  operations     ReturnOperation[]

  @@index([invoiceId])
  @@index([status, createdAt])
  creditApplications CustomerCreditApplication[]
  creditPayouts CustomerCreditPayout[]
}

model ReturnItem {
  id              String @id @default(cuid())
  returnRequestId String
  invoiceItemId   String
  productId       String
  qtyReturned     Float
  unitPrice       Float
  lineTotal       Float

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id])
  invoiceItem   InvoiceItem   @relation(fields: [invoiceItemId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])

  @@index([invoiceItemId])
  @@index([productId])
}

model BillingDraftRequest {
  id                 String             @id @default(cuid())
  requestNo          String             @unique
  status             DraftRequestStatus @default(PENDING)
  customerName       String?
  customerPhone      String?
  customerId         String?
  notes              String?            @db.Text
  createdById        String
  assignedCashierId  String?
  acceptedById       String?
  completedInvoiceId String?            @unique
  expiresAt          DateTime?
  firstViewedAt      DateTime?
  queuedOfflineAt    DateTime?
  modifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  acceptedAt         DateTime?
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?            @db.Text

  customer         Customer?          @relation(fields: [customerId], references: [id])
  createdBy        User               @relation("DraftRequestCreator", fields: [createdById], references: [id])
  assignedCashier  User?              @relation("DraftRequestAssignedCashier", fields: [assignedCashierId], references: [id])
  acceptedBy       User?              @relation("DraftRequestAcceptor", fields: [acceptedById], references: [id])
  cancelledBy      User?              @relation("DraftRequestCanceller", fields: [cancelledById], references: [id])
  completedInvoice Invoice?           @relation(fields: [completedInvoiceId], references: [id])
  items            DraftRequestItem[]

  @@index([status, createdAt])
  @@index([createdById, createdAt])
  @@index([assignedCashierId, status, createdAt])
  @@index([acceptedById, acceptedAt])
