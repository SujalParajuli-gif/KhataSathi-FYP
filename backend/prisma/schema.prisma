model ProductImportBatch {
  id           String    @id @default(cuid())
  sourceType   String
  fileName     String?
  supplier     String?
  status       String    @default("DRAFT")
  totalRows    Int       @default(0)
  importedRows Int       @default(0)
  failedRows   Int       @default(0)
  fileFingerprint String? @db.VarChar(64)
  fileSizeBytes  Int?
  sourceStoredFileName String?
  sourceStoredPath String?
  sourceMimeType String?
  sourceChecksum String? @db.VarChar(64)
  extractionMeta Json?
  priceMapping Json?
  repeatedFromBatchId String?
