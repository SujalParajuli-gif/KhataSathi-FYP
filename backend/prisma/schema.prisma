  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])
}

model Document {
  id             String       @id @default(cuid())
  documentType   DocumentType
  title          String? // human-readable searchable title; falls back to fileName for legacy rows
  fileName       String // original filename from user's upload
  storedFileName String // actual filename on disk (cuid-based)
  storedPath     String // relative path from storage root
  mimeType       String
  fileSize       Int // bytes
  checksum       String? // SHA-256 for integrity verification
  thumbnailFileName String? // protected WebP derivative stored beside the original
  thumbnailSize     Int? // bytes; included in storage usage reporting

  // Business metadata
  supplierName String?
  billNumber   String?
  billDate     DateTime?
  billAmount   Float?
  remarks      String?   @db.Text

  // Polymorphic link to related entity (same pattern as AuditLog)
  linkedEntityType String?
  linkedEntityId   String?
  visibility       DocumentVisibility @default(ALL_AUTHENTICATED)

  // Audit
  uploadedById String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?   @db.Text
  purgeAfter   DateTime?
  saleRecoveryStatus           SaleRecoveryStatus?
  recoveryCheckoutOperationKey String?             @unique @db.VarChar(120)
  recoveryCheckoutPayloadHash  String?             @db.Char(64)
  purchaseReview Json? // Untrusted observations and separately saved human corrections; never posting authority
  salesReview Json? // Sales observations and human corrections; never checkout or attachment authority

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([documentType, createdAt])
  @@index([documentType, saleRecoveryStatus, createdAt, id], map: "Document_sales_review_idx")
  @@index([linkedEntityType, linkedEntityId])
  @@index([visibility])
  @@index([title])
  @@index([supplierName])
  @@index([billDate])
  @@index([uploadedById])
  @@index([deletedAt])
  @@index([purgeAfter])
}

model SoftDeleteRecord {
  id             String    @id @default(cuid())
  entityType     String // "Product", "Document", "ProductImportBatch", etc.
  entityId       String
  entityLabel    String? // human-readable name/identifier for display
  deletedById    String
  deleteReason   String?   @db.Text
  entitySnapshot Json? // JSON snapshot for restore
  purgeAfter     DateTime // default: deletedAt + 30 days
  purgedAt       DateTime?
  createdAt      DateTime  @default(now())

  deletedBy User @relation(fields: [deletedById], references: [id])

  @@index([entityType, purgeAfter])
  @@index([deletedById])
  @@index([purgedAt])
}

model PaymentReceivingAccount {
  id                  String                           @id @db.VarChar(191)
