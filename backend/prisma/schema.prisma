  activeFor PaymentReceivingAccount? @relation("PaymentAccountActiveQr")
  createdBy User                     @relation("PaymentQrAssetCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([accountId])
}

model ReturnOperation {
