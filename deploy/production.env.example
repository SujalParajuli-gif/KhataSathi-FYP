# Copy this file to deploy/production.env. Never commit the copied file.
# Local rehearsal values:
APP_DOMAIN=:80
APP_ORIGIN=http://localhost

# Production examples after DNS points to the VPS:
# APP_DOMAIN=app.yourdomain.com
# APP_ORIGIN=https://app.yourdomain.com

TZ=Asia/Kathmandu
DB_NAME=khatasathi
DB_USER=khatasathi_app
# Generate each secret separately with: openssl rand -hex 32
# Hex is intentional: DB_PASSWORD is embedded in DATABASE_URL and stays URL-safe.
DB_PASSWORD=REPLACE_WITH_64_CHARACTER_HEX_VALUE
DB_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_64_CHARACTER_HEX_VALUE
SESSION_SECRET=REPLACE_WITH_A_THIRD_64_CHARACTER_HEX_VALUE
SESSION_TTL_HOURS=168

LOGIN_RATE_LIMIT_PER_MINUTE=5
API_RATE_LIMIT_REQUESTS=600
API_RATE_LIMIT_WINDOW_MINUTES=15
BACKGROUND_RATE_LIMIT_REQUESTS=200
MEDIA_RATE_LIMIT_REQUESTS=600

# Required only for scanned PDF and PNG/JPG supplier-catalog imports.
# Create the key in Google AI Studio and put it only in deploy/production.env.
# Never commit the real key. Each catalog row still requires human approval.
GEMINI_API_KEY=
GEMINI_IMPORT_MODEL=gemini-2.5-flash
GEMINI_IMPORT_FALLBACK_MODEL=gemini-3.5-flash-lite

# Keep sandbox values until FULL_POS is deliberately approved for production.
ESEWA_ENV=sandbox
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_SUCCESS_URL=
ESEWA_FAILURE_URL=

# Full recovery backups use an isolated Restic container. Create the password
# file manually at deploy/secrets/restic-password; never commit that file.
RESTIC_PASSWORD_FILE_HOST=./deploy/secrets/restic-password

# /repository is suitable for the local Docker rehearsal. Before the real pilot,
# change this to storage outside the VPS (for example an S3- or B2-compatible
# repository) so a lost VPS cannot destroy both the application and its backup.
RESTIC_REPOSITORY=/repository
RESTIC_BACKUP_HOST=khatasathi-vps
RESTIC_AUTO_INIT=true
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=6

# Populate only the credentials required by the selected remote repository.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
