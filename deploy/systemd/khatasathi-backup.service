[Unit]
Description=KhataSathi deduplicated full recovery backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/khatasathi
EnvironmentFile=/opt/khatasathi/deploy/production.env
Environment=KHATASATHI_PROJECT_DIR=/opt/khatasathi
ExecStart=/opt/khatasathi/deploy/scripts/backup.sh
User=root
Group=root
TimeoutStartSec=6h

[Install]
WantedBy=multi-user.target
